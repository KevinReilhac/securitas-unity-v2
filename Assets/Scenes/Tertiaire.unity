    infos:
    - type: 1
      text: "Contr\xF4ler les points sp\xE9cifiques de votre site avant la fermeture
        \r\n"
    - type: 1
      text: "Eteindre les lumi\xE8res \r\n"
    - type: 1
      text: "Eteindre les appareils \xE9lectriques non essentiels (ex : machine \xE0
        caf\xE9, photocopieurs). \r\n"
    - type: 1
      text: "R\xE9duire le chauffage ou la climatisation des bureaux \r\n"
    - type: 1
      text: "V\xE9rifier les points d\u2019eau \r\n"
    - type: 1
      text: "Editer un rapport des actions men\xE9es sur le portail client m@s\xE9curit\xE9
        \r\n"
    - type: 2
      text: 'Vos avantages '
    - type: 1
      text: "Solution adapt\xE9e \xE0 votre politique environnementale  \r\n"
    - type: 1
      text: "Am\xE9lioration de la note RSE de votre entreprise \r\n"
    - type: 1
      text: "R\xE9duction des co\xFBts li\xE9s \xE0 votre consommation \xE9nerg\xE9tique
        (\xE9lectricit\xE9, eau...). "
    - type: 1
      text: "R\xE9duction de votre bilan carbone \r\n"
    - type: 1
      text: "Augmentation de la long\xE9vit\xE9 de vos \xE9quipements \r\n"
  spacingOffset: 0
