  ParentArea: {fileID: 0}
  interestPointInfos:
    image: {fileID: 21300000, guid: d2767b704460c724192f303c329eabdf, type: 3}
    infos:
    - type: 1
      text: "R\xE9ceptionner et traiter les alertes : intrusion, appel d\u2019urgence,
        agression, code sous contrainte\r\n"
    - type: 1
      text: "Effectuer une lev\xE9e de vid\xE9o \xE0 distance \r\n"
    - type: 1
      text: "V\xE9rifier la transmission du signal du syst\xE8me d\u2019alarme toutes
        les 24h\r\n"
    - type: 1
      text: "G\xE9rer les coupures de secteur, niveau batteries / piles basses\r\n"
    - type: 1
      text: "Mettre en place les mesures conservatoires si n\xE9cessaire\r\n"
    - type: 2
      text: "Lev\xE9e de doute physique \r\n"
    - type: 1
      text: "V\xE9rifier l\u2019incident sur place par un agent de s\xE9curit\xE9
        mobile \r\n"
    - type: 1
      text: "Informer le Centre op\xE9rationnel de s\xE9curit\xE9 (COS) Securitas\r\n"
    - type: 1
      text: "Mettre en place les mesures conservatoires si n\xE9cessaire\r\n"
    - type: 1
      text: "Contacter les forces de l\u2019ordre \r\n"
    - type: 2
      text: "Vos avantages \r\n"
    - type: 1
      text: "Visualisation en temps r\xE9el des images \r\n"
    - type: 1
      text: "Contr\xF4le r\xE9gulier de votre installation de s\xE9curit\xE9\r\n"
    - type: 1
      text: "R\xE9duction des alarmes intempestives\r\n"
    - type: 1
      text: "T\xE9l\xE9maintenance et maintenance des syst\xE8mes de s\xFBret\xE9
        \r\n"
    - type: 1
      text: "Acc\xE8s privil\xE9gi\xE9 pour contacter les forces de l\u2019ordre\r\n"
    - type: 1
      text: "1er r\xE9seau d\u2019intervention sur alarme en France\r\n"
    - type: 1
      text: "Espace client M@s\xE9curit\xE9 avec acc\xE8s au journal des \xE9v\xE9nements,
        aux consignes de s\xE9curit\xE9 du site\r\n"
  spacingOffset: -6
