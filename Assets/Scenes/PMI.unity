    image: {fileID: 21300000, guid: 7d3afa4ce6764e04bbfc8bb711e94657, type: 3}
    infos:
    - type: 1
      text: "Contr\xF4ler mensuellement des installations et dispositifs techniques
        de s\xE9curit\xE9 obligatoires  \r\n"
    - type: 1
      text: "Les affichages (r\xE8glement int\xE9rieur, consignes de s\xE9curit\xE9,
        etc.) "
    - type: 1
      text: "Les \xE9clairages de s\xE9curit\xE9 \r\n"
    - type: 1
      text: "Les exutoires de fum\xE9es \r\n"
    - type: 1
      text: "Les \xE9quipements de s\xE9curit\xE9 incendie \r\n"
    - type: 1
      text: "Les portes coupe-feu, les issues de secours \r\n"
    - type: 2
      text: "Vos avantages  \r\n"
    - type: 1
      text: "D\xE9tection rapide des installations d\xE9fectueuses pouvant nuire
        \xE0 la sant\xE9 et la s\xE9curit\xE9 de vos salari\xE9s \r\n"
    - type: 1
      text: "Optimisation du temps au personnel de l\u2019entreprise  \r\n"
    - type: 1
      text: "Respect de la l\xE9gislation (article R. 4224-17 du Code du travail)\r\n"
    - type: 1
      text: "Flexibilit\xE9 des horaires de v\xE9rification\r\n"
  spacingOffset: 0
