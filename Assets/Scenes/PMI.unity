    infos:
    - type: 1
      text: "V\xE9rifier la conformit\xE9 de l\u2019\xE9tat de vos locaux \r\n"
    - type: 1
      text: "Inspecter rigoureusement tous les points de contr\xF4le d\xE9finis pr\xE9alablement
        \r\n"
    - type: 1
      text: "V\xE9rifier le respect des r\xE8gles de s\xE9curit\xE9 \r\n"
    - type: 1
      text: "Contr\xF4ler les personnes pr\xE9sentes sur le site \r\n"
    - type: 1
      text: 'Observer toutes situations anormales '
    - type: 1
      text: "Mettre en place les mesures conservatoires n\xE9cessaires en cas d\u2019incident
        \r\n"
    - type: 2
      text: "Vos avantages\u202F:  \r\n"
    - type: 1
      text: "Pr\xE9sence dissuasive et action pr\xE9ventive \r\n"
    - type: 1
      text: "Identification imm\xE9diate des personnes non autoris\xE9s sur site
        \r\n\r\n"
    - type: 1
      text: "D\xE9tection rapide des probl\xE8mes ou anomalies \r\n"
    - type: 1
      text: "Protection accrue des zones sensibles ou strat\xE9giques\r\n"
  spacingOffset: 0
