    infos:
    - type: 1
      text: "Inspecter visuellement les points sensibles du site \r\n"
    - type: 1
      text: "Contr\xF4ler les \xE9l\xE9ments techniques d\xE9finis par le client
        \r\n"
    - type: 1
      text: "R\xE9aliser des relev\xE9s de temp\xE9rature, de pression\u2026 \r\n"
    - type: 1
      text: "V\xE9rifier l\u2019absence de fuites d\u2019eau ou de produits dangereux 
        \r\n"
    - type: 1
      text: "Mettre en place des mesures conservatoires en cas d\u2019anomalies \r\n"
    - type: 2
      text: "Vos avantages  \r\n"
    - type: 1
      text: "Diminution du risque de perte d\u2019exploitation \r\n"
    - type: 1
      text: "D\xE9tection rapide des dysfonctionnements ou anomalies \r\n"
    - type: 1
      text: "R\xE9duction des risques de sinistres et de non-conformit\xE9 "
    - type: 1
      text: "Grande flexibilit\xE9 pour s\u2019adapter \xE0 diff\xE9rents environnements
        \r\n"
    - type: 1
      text: "El\xE9ments de preuve pour les assurances \r\n"
  spacingOffset: 0
