    infos:
    - type: 1
      text: "Vid\xE9osurveiller le site  \r\n"
    - type: 1
      text: "Traiter les alertes par nos op\xE9rateurs de t\xE9l\xE9surveillance 
        \r\n"
    - type: 1
      text: "Enregistrer les mises en et hors service du syst\xE8me d\u2019alarme"
    - type: 1
      text: "Effectuer des rondes vid\xE9o durant les horaires de fermeture \r\n"
    - type: 1
      text: "D\xE9tecter les \xE9v\xE8nements inhabituels et incidents \r\n"
    - type: 1
      text: "Effectuer une lev\xE9e de doute vid\xE9o \xE0 distance \r\n"
    - type: 1
      text: "Appeler les forces de l\u2019ordre si lev\xE9e de doute vid\xE9o positive  "
    - type: 2
      text: "Vos avantages \r\n"
    - type: 1
      text: "Pr\xE9sence s\xE9curitaire proactive et dissuasive avec les cam\xE9ras
        int\xE9rieures et ext\xE9rieures \r\n"
    - type: 1
      text: "Centres de t\xE9l\xE9surveillance certifi\xE9s APSAD P3 disponibles
        24h/24 et 7j/7 \r\n"
    - type: 1
      text: "Op\xE9rateurs de t\xE9l\xE9surveillance exp\xE9riment\xE9s et certifi\xE9s
        \r\n"
    - type: 1
      text: "R\xE9ponse rapide en cas d\u2019urgence \r\n"
    - type: 1
      text: "Renforcement de votre s\xE9curit\xE9 notamment pendant les p\xE9riodes
        de fermeture de votre site \r\n"
    - type: 1
      text: "Acc\xE8s privil\xE9gi\xE9 pour contacter les forces de l\u2019ordre
        \r\n"
  spacingOffset: 0
