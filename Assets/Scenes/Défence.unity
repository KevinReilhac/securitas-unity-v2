  interestPointInfos:
    image: {fileID: 21300000, guid: 9b78d73751382344bb2047af95626606, type: 3}
    infos:
    - type: 1
      text: "G\xE9rer et suivre les installations et le mat\xE9riel de s\xE9curit\xE9
        incendie"
    - type: 1
      text: "Sensibiliser \xE0 la s\xE9curit\xE9 les personnels du site et les visiteurs"
    - type: 1
      text: "Mettre \xE0 disposition des \xE9quipes d\u2019intervention 24/7"
    - type: 1
      text: "G\xE9rer le registre de s\xE9curit\xE9"
    - type: 1
      text: "Contr\xF4ler le respect des consignes incendie"
    - type: 1
      text: "Surveiller les travaux et d\xE9livrer le permis feu"
    - type: 2
      text: 'Vos avantages '
    - type: 1
      text: "Installations fiabilis\xE9es "
    - type: 1
      text: "R\xE9duction du risque incendie"
    - type: 1
      text: "Assurance d\u2019une interface professionnelle et efficace avec les
        services de secours"
    - type: 1
      text: "Respect de la r\xE8glementation incendie et des\u202Fcontraintes li\xE9es
        aux assurances"
    - type: 1
      text: "Tra\xE7abilit\xE9 des actions correctives"
  spacingOffset: 0
