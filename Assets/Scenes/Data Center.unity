  interestPointInfos:
    image: {fileID: 21300000, guid: c5baceb765e41834bb8e96670bd70e75, type: 3}
    infos:
    - type: 1
      text: "Rep\xE9rer en amont le fonctionnement du site, les syst\xE8mes de s\xE9curit\xE9,
        les failles visibles\r\n"
    - type: 1
      text: "Pr\xE9parer des sc\xE9nario d\u2019intervention"
    - type: 1
      text: "R\xE9aliser l\u2019exercice, de nuit ou de jour, par des collaborateurs
        Risk management sp\xE9cialis\xE9s"
    - type: 1
      text: "Tester sur site les syst\xE8mes de s\xE9curit\xE9 en place dans vos
        locaux (diversion, franchissement, infiltration, intrusion, effraction)"
    - type: 1
      text: "D\xE9briefer \xE0 chaud avec les \xE9quipes de s\xFBret\xE9 locales
        et les personnes impliqu\xE9es"
    - type: 1
      text: "Restituer \xE0 froid un livrable complet reprenant le d\xE9roulement
        de l\u2019exercice, les vuln\xE9rabilit\xE9s test\xE9es et les pr\xE9conisations
        pour l\u2019am\xE9lioration de la s\xFBret\xE9 globale"
    - type: 2
      text: Vos avantages
    - type: 1
      text: Exploitation des faiblesses structurelles des moyens mis en place
    - type: 1
      text: "Restitution d\u2019une vue d\u2019ensemble de votre dispositif de s\xE9curit\xE9"
    - type: 1
      text: "Pr\xE9conisations concr\xE8tes sur les aspects organisationnels, techniques
        et humains"
    - type: 1
      text: "Am\xE9lioration de la s\xFBret\xE9 du site\r\n"
  spacingOffset: 0
