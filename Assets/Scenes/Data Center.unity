    - type: 2
      text: Vos avantages
    - type: 1
      text: "R\xE9activit\xE9 en cas d\u2019incident"
    - type: 1
      text: "Limitation de la clause p\xE9nale du client envers ses salari\xE9s en
        mati\xE8re de secours \xE0 personnes "
    - type: 1
      text: "R\xE9pond aux pr\xE9conisations du M\xE9decin du travail, de la Caisse
        assurance retraite et sant\xE9 du travail (CARSAT)"
  spacingOffset: 0
