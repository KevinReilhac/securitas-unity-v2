    infos:
    - type: 1
      text: "Inspecter l\u2019ext\xE9rieur du b\xE2timent "
    - type: 1
      text: "V\xE9rifier les points sensibles et d\xE9tecter les incidents apparents"
    - type: 1
      text: "Contr\xF4ler l\u2019\xE9tat des issues ext\xE9rieures "
    - type: 1
      text: "Constater la pr\xE9sence \xE9ventuelle de personnes non autoris\xE9es"
    - type: 1
      text: "Proc\xE9der \xE0 la v\xE9rification des zones de stockage ext\xE9rieures"
    - type: 1
      text: "Signaler toute situation anormale, permettant une intervention rapide
        avant qu\u2019un incident ne survienne"
    - type: 2
      text: Vos avantages
    - type: 1
      text: "Tranquillit\xE9 d\u2019esprit avec un environnement s\xE9curis\xE9 "
    - type: 1
      text: 'Surveillance proactive '
    - type: 1
      text: Protection de vos infrastructures et de vos biens
    - type: 1
      text: "D\xE9tection rapide de toute situation inhabituelle ou suspecte "
    - type: 1
      text: "Tra\xE7abilit\xE9 des actions"
