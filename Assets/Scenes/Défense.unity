    infos:
    - type: 1
      text: "Analyser les vuln\xE9rabilit\xE9s du site "
    - type: 1
      text: "Organiser efficacement la pr\xE9vention des risques professionnels sur
        le site  "
    - type: 1
      text: "Contr\xF4ler les habilitations, les EPI\u2026 "
    - type: 1
      text: "Contr\xF4ler les consignes de s\xE9curit\xE9 de la coactivit\xE9"
    - type: 1
      text: "Participer \xE0 la coordination des travaux"
    - type: 1
      text: "D\xE9tecter les situations \xE0 risques"
    - type: 1
      text: "Analyser les accidents et proposer des plans d\u2019actions de pr\xE9vention"
    - type: 1
      text: "Animer les accueils s\xE9curit\xE9"
    - type: 2
      text: 'Vos avantages '
    - type: 1
      text: "R\xE9duction significative des risques et des accidents"
    - type: 1
      text: "Respect de la conformit\xE9 r\xE9glementaire du site "
    - type: 1
      text: "Am\xE9lioration de l\u2019efficacit\xE9 op\xE9rationnelle gr\xE2ce \xE0
        une coactivit\xE9 mieux ma\xEEtris\xE9e"
    - type: 1
      text: "Suivi transparent et pilotage optimis\xE9 gr\xE2ce \xE0 des audits et
        reporting"
    - type: 1
      text: "Conseil proactif pour vous accompagner dans la ma\xEEtrise et gestion
        de vos risques"
  spacingOffset: 0
