    infos:
    - type: 1
      text: "Prot\xE9ger votre personnel \xE0 l\u2019ouverture et \xE0 la fermeture
        de votre \xE9tablissement  "
    - type: 1
      text: "Pr\xE9venir des actes de malveillance et des vols "
    - type: 1
      text: "D\xE9tecter les situations de crise \r\n"
    - type: 1
      text: "Rep\xE9rer les colis suspects"
    - type: 1
      text: "Etablir un p\xE9rim\xE8tre de s\xE9curit\xE9 en cas d\u2019alerte ou
        de menace ext\xE9rieure "
    - type: 1
      text: "Organiser l\u2019\xE9vacuation du personnel et des clients pour \xE9viter
        tout mouvement de foule"
    - type: 2
      text: 'Vos avantages '
    - type: 1
      text: "Pr\xE9sence dissuasive"
    - type: 1
      text: "R\xE9activit\xE9 en cas de\u202Fsituations difficiles"
    - type: 1
      text: "Climat de s\xFBret\xE9 pour le personnel et les visiteurs du site"
